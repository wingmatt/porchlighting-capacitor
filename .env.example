# Backend API URL. Use http://10.0.2.2:8000/api from an Android emulator.
VITE_API_BASE_URL=http://localhost:8000/api

# Public Mapbox access token used by the map component.
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Legacy alternative accepted by the map component; use VITE_MAPBOX_TOKEN above
# for new installations.
# VITE_MAPBOX_ACCESS_TOKEN=pk.your-mapbox-public-token