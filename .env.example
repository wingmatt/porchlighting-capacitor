# Backend API URL. Use http://10.0.2.2:8000/api from an Android emulator.
VITE_API_BASE_URL=http://localhost:8000/api

# Public Mapbox access token used by the map component.
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Legacy alternative accepted by the map component; use VITE_MAPBOX_TOKEN above
# for new installations.
# VITE_MAPBOX_ACCESS_TOKEN=pk.your-mapbox-public-token

# Firebase Web SDK configuration. Use a dedicated test Firebase project for
# manual integration testing; these values are safe for the client application.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id

# VAPID Frontend Public Key
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=same-public-key-as-in-backend-env
